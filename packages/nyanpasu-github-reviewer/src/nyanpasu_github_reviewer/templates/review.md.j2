{{ data.pr_comparison.summary | md_body }}

{% for pr in data.pr_comparison.related_prs -%}
{{ pr.url | md_link(pr.url) }} · {{ pr.head_sha | md_code }} · 目标分支 {{ pr.base_ref | md_code }}

