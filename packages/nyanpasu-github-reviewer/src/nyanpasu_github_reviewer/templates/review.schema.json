{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "source", "summary", "stages", "findings", "disclosure"],
  "properties": {
    "status": {
      "enum": ["reviewing", "preliminary", "approved", "changes_requested", "comment", "incomplete"]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["head_sha"],
      "properties": {
        "head_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
      }
    },
    "summary": { "type": "string", "minLength": 1 },
    "stages": {
      "type": "object",
      "additionalProperties": false,
      "required": ["general", "deep"],
      "properties": {
        "general": {
          "allOf": [
            { "$ref": "#/$defs/stage" },
            { "properties": { "status": { "enum": ["running", "completed", "incomplete"] } } }
          ]
        },
        "deep": { "$ref": "#/$defs/stage" }
      }
    },
    "simplification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["production", "tests"],
      "properties": {
        "production": { "$ref": "#/$defs/necessityAudit" },
        "tests": { "$ref": "#/$defs/necessityAudit" }
      }
    },
    "findings": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/finding" }
    },
    "disclosure": {
      "type": "string",
      "minLength": 1,
      "description": "Plain text inside the current turn's disclosure footer; no HTML or Markdown."
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "stages": {
            "properties": { "deep": { "properties": { "status": { "const": "completed" } } } }
          }
        }
      },
      "then": {
        "required": ["simplification"],
        "properties": {
          "simplification": {
            "properties": {
              "production": { "properties": { "status": { "enum": ["completed", "skipped"] } } },
              "tests": { "properties": { "status": { "enum": ["completed", "skipped"] } } }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "status": { "const": "preliminary" } } },
      "then": {
        "required": ["stages"],
        "properties": {
          "stages": {
            "properties": {
              "general": { "properties": { "status": { "const": "completed" } } },
              "deep": { "properties": { "status": { "enum": ["pending", "running"] } } }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "status": { "enum": ["approved", "comment"] } } },
      "then": {
        "properties": {
          "stages": {
            "properties": {
              "general": { "properties": { "status": { "const": "completed" } } },
              "deep": { "properties": { "status": { "enum": ["completed", "skipped"] } } }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "status": { "const": "changes_requested" } } },
      "then": {
        "properties": {
          "findings": {
            "description": "Requesting changes requires an unresolved or partially resolved P0/P1 finding.",
            "not": {
              "additionalProperties": {
                "anyOf": [
                  { "properties": { "priority": { "enum": ["P2", "P3"] } } },
                  { "properties": { "status": { "enum": ["resolved", "superseded"] } } }
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "status": { "const": "approved" } } },
      "then": {
        "properties": {
          "findings": {
            "additionalProperties": {
              "properties": { "status": { "enum": ["resolved", "superseded"] } }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "necessityAudit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "summary", "entries"],
      "properties": {
        "status": { "enum": ["pending", "running", "completed", "skipped", "incomplete"] },
        "summary": {
          "type": "string",
          "minLength": 1,
          "description": "Checked scope and outcome, outstanding gaps, or a concrete reason no scope applies."
        },
        "entries": { "type": "array", "items": { "$ref": "#/$defs/necessityDecision" } }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "completed" } } },
          "then": { "properties": { "entries": { "minItems": 1 } } }
        },
        {
          "if": { "properties": { "status": { "const": "skipped" } } },
          "then": { "properties": { "entries": { "maxItems": 0 } } }
        }
      ]
    },
    "necessityDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope", "contract", "alternative", "decision", "evidence"],
      "properties": {
        "scope": { "type": "string", "minLength": 1 },
        "contract": { "type": "string", "minLength": 1 },
        "alternative": { "type": "string", "minLength": 1 },
        "decision": { "enum": ["remove", "merge", "replace", "retain"] },
        "evidence": { "type": "string", "minLength": 1 }
      }
    },
    "stage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "summary"],
      "properties": {
        "status": { "enum": ["pending", "running", "completed", "skipped", "incomplete"] },
        "summary": { "type": "string", "minLength": 1 }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "url", "priority", "status"],
      "allOf": [
        {
          "if": { "required": ["kind"], "properties": { "kind": { "const": "simplification" } } },
          "then": { "properties": { "priority": { "enum": ["P2", "P3"] } } }
        }
      ],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "pattern": "^https?://" },
        "priority": { "enum": ["P0", "P1", "P2", "P3"] },
        "kind": { "enum": ["correctness", "simplification"] },
        "status": { "enum": ["unresolved", "partial", "resolved", "superseded"] },
        "rule": {
          "type": "object",
          "additionalProperties": false,
          "required": ["title", "url"],
          "properties": {
            "title": { "type": "string", "minLength": 1 },
            "url": { "type": "string", "pattern": "^https?://" }
          }
        }
      }
    }
  }
}
